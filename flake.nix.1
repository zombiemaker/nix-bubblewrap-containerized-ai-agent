{
  description = "Experimenting with Eclipse Zenoh";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/26.05";
    zm_pixi_repo.url = "github:zombiemaker/nix-zm_pixi";
    zm_go_repo.url = "github:zombiemaker/nix-zm_go";
    zm_opencode_repo.url = "github:zombiemaker/nix-zm_opencode";
  };

  outputs = {
    self,
    nixpkgs,
    zm_pixi_repo,
    zm_go_repo,
    zm_opencode_repo,
  }:

  let
    nixpkgs_runtime_system = "x86_64-linux";
    pkgs = nixpkgs.legacyPackages.${nixpkgs_runtime_system};
    zm_pixi = zm_pixi_repo.v0_75_0;
    zm_go = zm_go_repo.v1_27_0;    
    zm_opencode = zm_opencode_repo.v2_0_26;

  in {
    latest = {
      machine_code = {
        x86_64 = {
          linux = {
            gnu_libc = {};

            musl_libc = {};

            llvm_libc = {};
          };

          macos = {};
        };

        aarch_64 = {
          linux = {
            gnu_libc = {};

            musl_libc = {};

            llvm_libc = {};
          };

          macos = {};
        };
      };

      byte_code = {

      };

      human_code = {
        c = {};
        cpp = {};
        csharp = {};
        gnu_bash = {};
        go = {};
        java = {};
        javascript = {};
        kotlin = {};
        lua = {};
        mojo = {};
        objective_c = {};
        nix = {};
        php = {};
        powershell = {};
        python = {};
        r = {};
        rust = {};
        scala = {};
        swift = {};
        typescript = {};
        webassembly_text = {};
      };

      human_code_editor_toolset = {
        gnu_emacs = {};
        gnu_nano = {};
        micro = {};
        neovim = {};
        vscode = {};
        vscodium = {};
      };

      human_code_dev_time = {
        amazon_corretto = {};
        dotnet = {};
        go_sdk = {};
        gnu_bash = {};
        gnu_cc = {};
        graalpy = {};
        cpython = {};
        jython = {};
        llvm = {};
        llvm_clang = {};
        microsoft_openjdk = {};
        mojo_sdk = {};
        nix_runtime = {};
        nodejs = {};
        oracle_jdk = {};
        oracle_openjdk = {};
        powershell = {};
        pypi_python = {};
        redhat_openjdk = {};
        rust_toolchain = {};
        rust_gcc = {};
        wasmtime = {};
      };

      human_code_build_time = {
        amazon_corretto = {};
        dotnet = {};
        eclipse_temurin = {};
        go_sdk = {};
        gnu_bash = {};
        gnu_cc = {};
        graalpy = {};
        cpython = {};
        jython = {};
        llvm = {};
        llvm_clang = {};
        microsoft_openjdk = {};
        mojo_sdk = {};
        nix_runtime = {};
        nodejs = {};
        oracle_jdk = {};
        oracle_openjdk = {};
        powershell = {};
        pypi_python = {};
        redhat_openjdk = {};
        rust_toolchain = {};
        rust_gcc = {};
        wasmtime = {};
      };

      human_code_run_time = {
        amazon_corretto = {};
        dotnet = {};
        eclipse_temurin = {};
        go_sdk = {};
        gnu_bash = {};
        gnu_cc = {};
        graalpy = {};
        cpython = {};
        jython = {};
        llvm = {};
        llvm_clang = {};
        microsoft_openjdk = {};
        mojo_runtime = {};
        nix_runtime = {};
        nodejs = {};
        oracle_jdk = {};
        oracle_openjdk = {};
        powershell = {};
        pypi_python = {};
        redhat_openjdk = {};
        rust_toolchain = {};
        rust_gcc = {};
        wasmtime = {};
      };


      data_dev_time = {
        apache_arrow = {};
        apache_avro = {};
        apache_iceberg = {};
        apache_orc = {};
        apache_paimon = {};
        apache_parquet = {};
        flatbuffers = {};
        json_schema = {};
        protobufs = {};
        rdf = {};
        vortex = {};
        webassembly_idl = {};
        xml_schema = {};
      };


      data_run_time = {
        apache_arrow = {};
        apache_avro = {};
        apache_iceberg = {};
        apache_orc = {};
        apache_paimon = {};
        apache_parquet = {};
        flatbuffers = {};
        json_schema = {};
        protobufs = {};
        rdf = {};
        vortex = {};
        webassembly_idl = {};
        xml_schema = {};
      };


      shells = {
        x86_64 = {
          linux = {
            gnu_libc = {
              pwsh_llvm_clang = pkgs.mkShell {
                name = "pwsh_llvm_clang";

                buildInputs = [
                  pkgs.bashInteractive
                ];

                packages = [
                  pkgs.git
                  pkgs.powershell
                  pkgs.clang_22
                  zm_opencode.machine_code.x86_64.linux.gnu_libc
                ];

                shellHook = ''
                  export NIX_FLAKE_ROOT_DIR=$(git rev-parse --show-toplevel)
                  echo "NIX_FLAKE_ROOT_DIR is set to: $NIX_FLAKE_ROOT_DIR"
                  echo "NIX_FLAKE_ROOT_DIR should be root directory where flake.nix is located"

                  export PATH=.:$PATH

                  # Replace GNU Bash shell with PowerShell
                  echo "Make sure that PowerShell profile.ps1 does not alter Nix environment variables or add environment variables that affect determinism of Nix shell environment"

                  # This leaves Bash as the shell
                  exec pwsh -NoLogo -NoExit -File $NIX_FLAKE_ROOT_DIR/post_nix_shell.ps1
                '';
              };

              pwsh_pixi_go = pkgs.mkShell {
                name = "pwsh_pixi_go";

                buildInputs = [
                  pkgs.bashInteractive
                ];

                packages = [
                  pkgs.git
                  pkgs.powershell
                  pkgs.gnumake
                  pkgs.which
                  pkgs.bubblewrap
                  zm_pixi.machine_code.x86_64.linux.musl_libc
                  zm_go.machine_code.x86_64.linux.gnu_libc
                  zm_opencode.machine_code.x86_64.linux.gnu_libc
                  # pkgs.nethogs
                  # pkgs.glances
                ];

                shellHook = ''
                  export NIX_FLAKE_ROOT_DIR=$(git rev-parse --show-toplevel)
                  echo "NIX_FLAKE_ROOT_DIR is set to: $NIX_FLAKE_ROOT_DIR"
                  echo "NIX_FLAKE_ROOT_DIR should be root directory where flake.nix is located"

                  mkdir -p $NIX_FLAKE_ROOT_DIR/.apps/bin
                  mkdir -p $NIX_FLAKE_ROOT_DIR/.temp
                  export PATH=.:$NIX_FLAKE_ROOT_DIR/.apps/bin:$PATH
                  export VSC_WORKSPACE_ROOT=$NIX_FLAKE_ROOT_DIR
                  export TEMP=$NIX_FLAKE_ROOT_DIR/.temp
                  export TEMPDIR=$NIX_FLAKE_ROOT_DIR/.temp
                  export TMP=$NIX_FLAKE_ROOT_DIR/.temp
                  export TMPDIR=$NIX_FLAKE_ROOT_DIR/.temp

                  mkdir -p $NIX_FLAKE_ROOT_DIR/.apps/go/bin
                  export GOPATH=$NIX_FLAKE_ROOT_DIR/.apps/go
                  export GOBIN=$NIX_FLAKE_ROOT_DIR/.apps/go/bin
                  export GOTMPDIR=$NIX_FLAKE_ROOT_DIR/.temp
                  export PATH=$GOBIN:$PATH
                  go install github.com/go-delve/delve/cmd/dlv@latest

                  # Replace GNU Bash shell with PowerShell
                  echo "Make sure that PowerShell profile.ps1 does not alter Nix environment variables or add environment variables that affect determinism of Nix shell environment"
                  exec pwsh -NoLogo -NoExit -File $NIX_FLAKE_ROOT_DIR/post_nix_shell.ps1
                '';
              };

              pwsh_pixi_mojo = pkgs.mkShell {
                name = "pwsh_pixi_mojo";

                buildInputs = [
                  pkgs.bashInteractive
                ];

                packages = [
                  pkgs.git
                  pkgs.powershell
                  pkgs.gnumake
                  pkgs.bubblewrap
                  zm_pixi.machine_code.x86_64.linux.musl_libc
                  zm_opencode.machine_code.x86_64.linux.gnu_libc
                  # these mess with PYTHONPATH which breaks Pixi Mojo environment
                  # pkgs.nethogs
                  # pkgs.glances
                ];

                shellHook = ''
                  export NIX_FLAKE_ROOT_DIR=$(git rev-parse --show-toplevel)
                  echo "NIX_FLAKE_ROOT_DIR is set to: $NIX_FLAKE_ROOT_DIR"
                  echo "NIX_FLAKE_ROOT_DIR should be root directory where flake.nix is located"

                  export PATH=.:$PATH
                  
                  # Replace GNU Bash shell with PowerShell
                  echo "Make sure that PowerShell profile.ps1 does not alter Nix environment variables or add environment variables that affect determinism of Nix shell environment"
                  echo "Commands:"
                  echo " Activate Pixi shell: pixi shell --manifest-path \$PIXI_DIR"
                  echo " Activate Pixi shell via GNU Bash alias :  pixi-shell"
                  echo " (Pixi shell) Activate Mojo repl shell : mojo repl"
                  echo " (Pixi shell) Run Mojo tests : mojo test -I production-code-dir-path test-code-dir-path"

                  # This leaves Bash as the shell
                  exec pwsh -NoLogo -NoExit -File $NIX_FLAKE_ROOT_DIR/post_nix_shell.ps1
                '';
              };

              pwsh_pixi_cpython = pkgs.mkShell {
                name = "pwsh_pixi_cpython";

                buildInputs = [
                  pkgs.bashInteractive
                ];

                packages = [
                  pkgs.git
                  pkgs.powershell
                  zm_pixi.machine_code.x86_64.linux.musl_libc
                  zm_opencode.machine_code.x86_64.linux.gnu_libc
                ];

                shellHook = ''
                  export NIX_FLAKE_ROOT_DIR=$(git rev-parse --show-toplevel)
                  echo "NIX_FLAKE_ROOT_DIR is set to: $NIX_FLAKE_ROOT_DIR"
                  echo "NIX_FLAKE_ROOT_DIR should be root directory where flake.nix is located"

                  export PATH=.:$PATH

                  # Replace GNU Bash shell with PowerShell
                  echo "Make sure that PowerShell profile.ps1 does not alter Nix environment variables or add environment variables that affect determinism of Nix shell environment"

                  # This leaves Bash as the shell
                  exec pwsh -NoLogo -NoExit -File $NIX_FLAKE_ROOT_DIR/post_nix_shell.ps1
                '';
              };

              pwsh_rust_toolchain = pkgs.mkShell {
                name = "pwsh_rust_toolchain";

                buildInputs = [
                  pkgs.bashInteractive
                ];

                packages = [
                  pkgs.powershell
                ];

                shellHook = ''
                  export NIX_FLAKE_ROOT_DIR=$(git rev-parse --show-toplevel)
                  echo "NIX_FLAKE_ROOT_DIR is set to: $NIX_FLAKE_ROOT_DIR"
                  echo "NIX_FLAKE_ROOT_DIR should be root directory where flake.nix is located"

                  export PATH=.:$PATH

                  # Replace GNU Bash shell with PowerShell
                  echo "Make sure that PowerShell profile.ps1 does not alter Nix environment variables or add environment variables that affect determinism of Nix shell environment"

                  # This leaves Bash as the shell
                  exec pwsh -NoLogo -NoExit -File $NIX_FLAKE_ROOT_DIR/post_nix_shell.ps1
                '';
              };

              default = self.shells.x86_64.linux.gnu_libc.pwsh_pixi_cpython;
            };

            musl_libc = {
              pwsh_pixi_cpython = pkgs.mkShell {
                name = "pwsh_pixi_cpython";

                buildInputs = [
                  pkgs.bashInteractive
                ];

                packages = [
                  pkgs.powershell
                  pkgs.pixi
                ];
              };

              default = self.shells.x86_64.linux.musl_libc.pwsh_pixi_cpython;
            };
          };
        };
      };
    };
  };
}